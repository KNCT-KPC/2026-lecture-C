{
  "name": "c-lecture",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:portal": "cd portal && vite",
    "dev:slide": "sh -c 'slidev \"$1.md\" --open' _",
    "build:portal": "cd portal && vite build",
    "build:slides": "for f in day*.md; do slidev build \"$f\" --out \"dist/${f%.md}\" --base \"/${f%.md}/\" & done; wait",
    "build": "npm-run-all --parallel build:portal build:slides"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@slidev/cli": "^52.15.2",
    "@slidev/theme-default": "^0.25.0",
    "@vitejs/plugin-react": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
